    Ansible - Install Apache and Start Service
    - name: Install and Start Apache
      hosts: all
      become: yes
      tasks:
        - name: Install apache
          yum:
            name: httpd
            state: present

        - name: Start apache
          service:
             name: httpd
             state: started
             enabled: yes


