    Ansible - Install and Configure Ngnix
    - name: Install and configure Ngnix
      hosts: all
      become: yes
      tasks:
        - name: Install Ngnix
          yum:
            name: ngnix
            state: present
        - name: Configure ngnix
          template:
            src: ngnix.conf.j2
            dest: /etc/nginx/nginx.conf
        - name: Start nginx service
          service:
            name: ngnix
            state: started
            enable: yes


    Terraform - EC2 with Security Group
resource "aws_security_group" "example"
{
    name          = "example_security_group"
    description   = "Allow SSH and HTTP"
    ingress {
        from_port    = 22
        to_port      = 22
        protocol     = "tcp"
        cidr_blocks  = ["0.0.0.0/0"]
    }
    ingress {
        from_port    = 80
        to_port      = 80
        protocol     = "tcp"
        cidr_blocks  = ["0.0.0.0/0"]
    }

    egress {
        from_port   = 0
        to_port     = 0
        protocol    = "-1"
        cidr_blocks = ["0.0.0.0/0"]
    }
}

