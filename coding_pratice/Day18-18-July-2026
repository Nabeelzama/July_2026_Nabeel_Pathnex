# Day 18 - High Availability , Multi-Region, and Auto-scaling

##   Ansible - Configure HAProxy for Load Balancing

````yaml
- name: Setup HAProxy Load Balancer
  hosts: all
  become: yes
  tasks:
    - name: Install HAProxy
      yum:
      state: present
    - name: Configure HAProxy
      template:
        src: haproxy.cfg.j2
        dest: /etc/haproxy/haproxy.cfg
    - name: Start HAProxy service
      service:
        name: haproxy
        state: started
        enabled: yes
   Terraform - Multi-Region Auto-scaling
Group with ALB
resource "aws_lb" "pathnex_lb" {
  name                  = "pathnex-lb"
  internal              = false
  load_balancer_type    = "application"
  security_group        = [aws_security_group.allow_ssh_http.id]
  subnets               = [aws_subnet.public.id, aws_subnet.public2.id]
}

resource "aws_autoscaling_group"
"pathnex_asg" {
    desired_capacity        = 3
    max-size                = 5
    min-size                = 2
    vpc_zone_identifier      = [aws_subnet.public.id, aws_subnet.public2.id]
    launch_configuration =
    aws_launch_configuration.pathnex_config.id
}

